COMPOSE_PROJECT_NAME=moodle-actions
MOODLE_URL=http://localhost:18082
MOODLE_PORT=18082
COLLECTOR_PORT=18081
COLLECTOR_API_PORT=18080
COLLECTOR_API_URL=http://localhost:18081/api
MONGO_ROOT_USER=collectorroot
MONGO_ROOT_PASSWORD=MongoLocal123!
MONGODB_DATABASE=moodle-statistics
# Disk admission budget for this database, including indexes (GB=10^9 bytes).
COLLECTOR_DB_MAX_SIZE=100GB
COLLECTOR_DB_CHECK_INTERVAL_SECONDS=5
MARIADB_ROOT_PASSWORD=MariaRootLocal123!
MOODLE_DB_PASSWORD=MoodleDatabaseLocal123!
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=AdminLocal123!
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_STUDENT_PASSWORD=StudentLocal123!
MOODLE_TEACHER_PASSWORD=TeacherLocal123!
COLLECTOR_ADMIN_EMAIL=collector@example.com
COLLECTOR_ADMIN_PASSWORD=CollectorLocal123!
# Initialized by python3 scripts/init-auth-secrets.py; never commit actual values.
COLLECTOR_AUTH_SECRET=
COLLECTOR_INGEST_KEY=
COLLECTOR_ACCESS_TOKEN_TTL_SECONDS=43200
